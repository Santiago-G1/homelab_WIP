#!/bin/sh
# Managed by Ansible (roles/pve_tune).
# Containers never issue discards: their freed blocks stay allocated in the
# thin pool until `pct fstrim` runs here (inside the guest it fails with EPERM).
for c in $(pct list | awk 'NR > 1 && $2 == "running" { print $1 }'); do
    pct fstrim "$c" 2>/dev/null | sed "s/^/CT $c: /"
done
