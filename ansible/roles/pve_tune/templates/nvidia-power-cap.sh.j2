#!/bin/sh
# Managed by Ansible (roles/pve_tune).
# Cap every visible Tesla P100 at {{ pve_tune_gpu_power_limit_w }} W each.
# Measured sweet spot (9B Q4 on one card, -p 4096, app clock pinned at
# {{ pve_tune_gpu_clock_sm_mhz }} MHz):
#   125 W -> 676 t/s, clock dips to 1063 (SW power cap)
#   150 W -> 731 t/s, dips to 1177
#   175 W -> 759 t/s, dips to 1278
#   {{ pve_tune_gpu_power_limit_w }} W -> 762 t/s, holds the app clock, no throttle   <-- knee
#   225/250 W -> 762 t/s, identical; the card self-limits at ~195 W
# The two cards together draw ~365 W at full tilt, ~440 W with the CPU, which is
# ~52 % of the 850 W PSU.
for i in $(nvidia-smi --query-gpu=index --format=csv,noheader 2>/dev/null); do
    nvidia-smi -i $i -pl {{ pve_tune_gpu_power_limit_w }} >/dev/null 2>&1 &&         echo gpu$i capped at {{ pve_tune_gpu_power_limit_w }} W || echo gpu$i: could not set {{ pve_tune_gpu_power_limit_w }} W
done
