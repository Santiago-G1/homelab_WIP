# Rendered by Ansible (roles/pve_tune).
[Unit]
Description=Homelab sampler: RAM, pressure, ARC, temps and GPU every {{ pve_tune_sampler_interval }} s
After=multi-user.target
# Never give up: a boot where nvidia-smi is not ready must not exhaust the start
# limit.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/sbin/homelab-sampler {{ pve_tune_sampler_log }} {{ pve_tune_sampler_interval }} {{ pve_tune_sampler_max_bytes }}
# One small write every interval: it must never compete with the containers.
Nice=10
IOSchedulingClass=idle
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
