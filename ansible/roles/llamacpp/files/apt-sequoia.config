# Copy of Debian 13's /usr/share/apt/default-sequoia.config with a single
# change: sha1.second_preimage_resistance is pushed from 2026-02-01 to
# 2035-02-01.
#
# Why: apt on trixie verifies repository signatures with Sequoia, and Sequoia's
# stock policy stops accepting SHA1 signatures after 2026-02-01. NVIDIA still
# ships a SHA1 self-signature in the CUDA repository key
# (EB693B3035CD5710E231E123A4B469963BF863CC), so apt rejects the whole CUDA
# repository with "Signing key ... is not bound ... SHA1 is not considered
# secure since 2026-02-01" and no CUDA package can be installed. SHA1
# second-preimage resistance is the documented knob for exactly this case
# ("Extend the expiry for legacy repositories"), so only that expiry changes;
# every other value keeps Debian's policy.
#
# Revisit when NVIDIA re-signs the repository key with SHA256 or the CUDA
# toolkit is no longer needed (CUDA 12.9 is the last release targeting Pascal).

[asymmetric_algorithms]
dsa2048 = 2024-02-01
dsa3072 = 2024-02-01
dsa4096 = 2024-02-01
brainpoolp256 = 2028-02-01
brainpoolp384 = 2028-02-01
brainpoolp512 = 2028-02-01
rsa2048  = 2030-02-01

[hash_algorithms]
sha1.second_preimage_resistance = 2035-02-01
sha224 = 2026-02-01

[packets]
signature.v3 = 2026-02-01
