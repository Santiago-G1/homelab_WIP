# Debian 13's default-sequoia.config with one change: SHA1 second-preimage
# resistance is pushed from 2026-02-01 to 2035-02-01.
#
# NVIDIA still ships a SHA1 self-signature in the CUDA repository key, so with
# the stock policy apt rejects the whole CUDA repository on trixie ("SHA1 is not
# considered secure since 2026-02-01"). Only that expiry changes. Revisit when
# NVIDIA re-signs the key with SHA256.

[asymmetric_algorithms]
dsa2048 = 2024-02-01
dsa3072 = 2024-02-01
dsa4096 = 2024-02-01
brainpoolp256 = 2028-02-01
brainpoolp384 = 2028-02-01
brainpoolp512 = 2028-02-01
rsa2048  = 2030-02-01

[hash_algorithms]
sha1.second_preimage_resistance = 2035-02-01
sha224 = 2026-02-01

[packets]
signature.v3 = 2026-02-01
