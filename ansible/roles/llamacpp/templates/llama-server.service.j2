# Managed by Ansible (roles/llamacpp).
[Unit]
Description=llama.cpp server (router mode)
After=network-online.target
Wants=network-online.target

[Service]
User={{ llamacpp_user }}
Group={{ llamacpp_user }}
SupplementaryGroups=video
CacheDirectory={{ llamacpp_user }}
Environment=LLAMA_CACHE=/var/cache/{{ llamacpp_user }}
ExecStart={{ llamacpp_binary }} \
  --models-dir {{ llamacpp_models_dir }} \
  --models-preset {{ llamacpp_preset_file }} \
  --models-max {{ llamacpp_models_max }} \
  --host 0.0.0.0 --port {{ llamacpp_port }} \
  --cors-origins {{ llamacpp_cors_origins }} \
  --no-cors-credentials \
  --metrics
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
