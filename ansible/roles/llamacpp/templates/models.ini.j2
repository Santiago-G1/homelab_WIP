# Managed by Ansible (roles/llamacpp).
version = 1

[*]
{% for k, v in llamacpp_global_args.items() %}
{{ k }} = {{ v }}
{% endfor %}
{% for model, opts in llamacpp_model_overrides.items() %}

[{{ model }}]
{% if opts.get('comment') %}
{{ opts['comment'] | trim }}
{% endif %}
{% for k, v in opts.items() if k != 'comment' %}
{{ k }} = {{ v }}
{% endfor %}
{% endfor %}
