# Managed by Ansible. Every advertised model needs a line in litellm_models:
# a wildcard route would also publish LiteLLM's OpenAI catalogue. Only the top
# level of llamacpp_models_dir is addressable.
model_list:
{% for model in litellm_models %}
  - model_name: "{{ model }}"
    litellm_params:
      model: "openai/{{ model }}"
      api_base: "{{ litellm_api_base }}"
      api_key: "{{ litellm_backend_api_key }}"
{% endfor %}
general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL

litellm_settings:
  # The router rejects unknown sampling parameters.
  drop_params: true
