{# hermes' own name for the provider key; the value is Bifrost's, scoped to the
   agent's models. #}
{% set a = hermes_agents[item.agent] %}
{{ hermes_llm_key_env }}={{ vault_bifrost_agent_key }}
SEARXNG_URL={{ hermes_searxng_uri }}
{% if a.telegram | default(false) %}
TELEGRAM_BOT_TOKEN={{ vault_agent_telegram_bot_token }}
TELEGRAM_ALLOWED_USERS={{ vault_agent_telegram_user_id }}
{% endif %}
