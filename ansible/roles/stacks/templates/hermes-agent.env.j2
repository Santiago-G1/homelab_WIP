# Rendered by Ansible (roles/stacks). The profile's own .env; the dashboard can
# write here too, and the next deploy overwrites it.
{% set a = hermes_agents[item.agent] %}
LITELLM_API_KEY={{ vault_agent_litellm_api_key }}
{% if a.telegram | default(false) %}
TELEGRAM_BOT_TOKEN={{ vault_agent_telegram_bot_token }}
TELEGRAM_ALLOWED_USERS={{ vault_agent_telegram_user_id }}
{% endif %}
