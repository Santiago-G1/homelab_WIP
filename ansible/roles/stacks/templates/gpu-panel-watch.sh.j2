#!/bin/bash
# Managed by Ansible (roles/stacks).
#
# A green container is not a working panel: it stayed "Up" the night it lost its
# network and answered nothing. This asks the panel what a client asks it, and
# restarts the container when the panel is the one failing.
#
# The two failures look alike from here and are not. A host the probe cannot
# reach still leaves the panel answering: /api/status returns 200 and carries
# the errors the probe collected, so a restart fixes nothing and fights the
# healthcheck, which also turns red on that path. Only a lost network on the CT
# (no /api/session) or a panel that does not answer at all is its own problem.
set -uo pipefail

{# Probe the address the port is actually published on: PUBLISH_ADDR pins it to
   the host's own address, and 127.0.0.1 would then refuse every connection and
   look exactly like a dead panel. #}
{% set probe_host = (stack.publish_addr | default('127.0.0.1', true)) | replace('[', '') | replace(']', '') %}
{% if probe_host in ['0.0.0.0', '::'] %}{% set probe_host = '127.0.0.1' %}
{% elif ':' in probe_host %}{% set probe_host = '[' ~ probe_host ~ ']' %}{% endif %}
PANEL="http://{{ probe_host }}:{{ service_ports.gpu_panel }}"
ENV_FILE="{{ stacks_root }}/gpu-panel/.env"
# Not in /var: the restart limit belongs to this boot, not to the disk.
STAMP=/run/gpu-panel-watch.restart
MIN_INTERVAL=600

# The panel is the one failing: restart it, at most once per MIN_INTERVAL.
restart_panel() {
    logger -t gpu-panel-watch "panel failing: $*"
    local now last
    now=$(date +%s)
    last=$(cat "$STAMP" 2>/dev/null || echo 0)
    if ((now - last < MIN_INTERVAL)); then
        logger -t gpu-panel-watch \
            "not restarting: the last restart was $(((now - last) / 60)) min ago"
        exit 1
    fi
    printf '%s\n' "$now" >"$STAMP"
    logger -t gpu-panel-watch "restarting gpu-panel"
    if ! docker restart gpu-panel >/dev/null 2>&1; then
        logger -t gpu-panel-watch "docker restart gpu-panel failed"
    fi
    exit 1
}

# The host behind the cards is the one failing: the panel answers, so the restart
# changes nothing and the journal line is what an operator has to read.
host_failing() {
    logger -t gpu-panel-watch "host probe failing: $*"
    exit 0
}

# The session endpoint needs no credential and touches no other host: it is the
# process answering on its own port, and the one the healthcheck already uses.
curl -fsS -m 5 "$PANEL/api/session" >/dev/null || restart_panel "no answer from /api/session"

# Read the two settings that decide what a good answer is. Neither is echoed:
# one signs sessions, and the other is the card count this node promises. A
# missing one is a broken .env, which a restart does not rewrite.
token=$(sed -n 's/^PANEL_TOKEN=//p' "$ENV_FILE" 2>/dev/null | head -n1)
if [ -z "$token" ]; then
    logger -t gpu-panel-watch "PANEL_TOKEN is not set in $ENV_FILE"
    exit 1
fi
expected=$(sed -n 's/^GPU_EXPECTED=//p' "$ENV_FILE" 2>/dev/null | head -n1)
if [ -z "$expected" ]; then
    logger -t gpu-panel-watch "GPU_EXPECTED is not set in $ENV_FILE"
    exit 1
fi

# /api/status drives every card over SSH, which is what catches a broken key or
# an unreachable host. It takes seconds, so it gets its own longer deadline.
# A timeout, a 5xx from its own process or a body that is not the JSON it
# promises is the panel failing and nothing else.
status=$(curl -fsS -m 25 -H "Authorization: Bearer $token" "$PANEL/api/status") \
    || restart_panel "/api/status did not answer"

cards=$(jq -r '.gpus | length' <<<"$status" 2>/dev/null) \
    || restart_panel "/api/status did not answer with JSON"

# What the probe could not do is the host's news, not the panel's: SSH may be
# down, the key wrong or the far side busy. It says so and stops there.
errors=$(jq -c '.inventory.probe.errors // []' <<<"$status")
[ "$errors" = "[]" ] || host_failing "$errors"

# A card the probe did not report is the same host-side news, for a client.
[ "$cards" = "$expected" ] || host_failing "$cards card(s) reported, $expected expected"

exit 0
