# Managed by Ansible (roles/stacks).
# /tank/immich already holds the library and its ACLs grant uid 999, which is
# the uid the original installation used, so run the server with that uid.
services:
  immich-server:
    user: "999:991"
    # Intel iGPU render node (VAAPI); terraform/proxmox/lxc_media.tf passes it
    # through with this group. The accel setting itself lives in Immich's admin
    # UI and is stored in the database.
    devices:
      - /dev/dri/renderD128:/dev/dri/renderD128
