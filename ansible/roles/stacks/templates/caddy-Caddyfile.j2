{#
   Rendered from the service catalog; addresses come from the inventory, so a
   container that moves needs no change here.
#}

{
	email admin@{$DOMAINNAME_HS}
	# Sites declare explicit addresses, so no redirect server is created.
	auto_https disable_redirects
}

# DNS-01 through Cloudflare: it also covers the *.{$DOMAINNAME_HS} wildcard.
(routes) {
	map {host} {backend} {
{% for service in homelab_services %}
{% if service.note is defined %}
		# {{ service.note }}
{% endif %}
		{{ service.host }}.{$DOMAINNAME_HS} {{ hostvars[service.server].ansible_host }}:{{ service.port }}
{% endfor %}
	}
	reverse_proxy {backend}
}

https://*.{$DOMAINNAME_HS} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Not the lab resolver: Blocky answers every *.{$DOMAINNAME_HS} itself.
	}
	import routes
}

http://*.{$DOMAINNAME_HS} {
	redir https://{host}{uri} permanent
}
