# Blocky — DNS resolver and ad-blocker for the lab.
#
# Replaces AdGuard Home. Every setting below mirrors the AdGuard configuration
# that was recovered from the container backup, so resolution behaviour is
# unchanged: same upstream, same blocklists, same rewrites.

# AdGuard upstream_dns / bootstrap_dns / upstream_mode: parallel.
#
# Quad9's *filtered* endpoint (dns.quad9.net = 9.9.9.9 / 149.112.112.112) over
# DoH. It replaces the Mullvad endpoint this lab used, which is being retired.
# Filtered on purpose since 2026-10-24: Quad9's malware/phishing list is a second
# layer on top of Blocky's own blocklists, at the cost of Quad9 dropping some
# names without Blocky logging them (dns10.quad9.net is the unfiltered pair). DoH
# keeps every query off the ISP's resolver.
upstreams:
  groups:
    default:
      - https://dns.quad9.net/dns-query

# Plain DNS, used only to resolve the DoH endpoint's own hostname
# (dns.quad9.net) and the blocklist URLs: the DoH upstream cannot bootstrap
# itself. Quad9's filtered addresses come first, the unfiltered pair next, and
# 1.1.1.1 last.
bootstrapDns:
  - 9.9.9.9
  - 149.112.112.112
  - 9.9.9.10
  - 149.112.112.10
  - 194.242.2.6
  - 194.242.2.4
  - 1.1.1.1

ports:
  dns: 53
  # 80 keeps the previous DoH URL (http://192.168.10.3/dns-query) working;
  # 4000 is what the reverse proxy and Prometheus use.
  http:
    - 80
    - 4000

# AdGuard aaaa_disabled: true and refuse_any: true.
filtering:
  queryTypes:
    - AAAA
    - ANY

# AdGuard rewrites: every *.<zone> name resolves to the reverse proxy
# (Blocky resolves subdomains of a mapping too). The address comes from the
# inventory, so moving the proxy is a one-line change in hosts.ini.
customDNS:
  customTTL: 1h
  mapping:
    "{{ vault_domainname_hs }}": {{ hostvars['caddy'].ansible_host }}

# The filters AdGuard had enabled. HostlistsRegistry serves them in AdGuard
# syntax, which Blocky cannot parse, so these are the same HaGeZi lists in their
# domain-list format (one domain per line).
blocking:
  denylists:
    hagezi:
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/ultimate-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/tif-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/native.apple-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/gambling-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/native.oppo-realme-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/native.winoffice-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/native.xiaomi-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/spam-tlds-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/urlshortener-onlydomains.txt
    special:
      - |
        # AdGuard blocked_hosts
        version.bind
        id.server
        hostname.bind
  allowlists:
    hagezi:
      - |
        # AdGuard user_rules: @@||huggingface.co^$important
        huggingface.co
        cdn-lfs.huggingface.co
        hf.co
  clientGroupsBlock:
    default:
      - hagezi
      - special
  # AdGuard blocking_mode "default" answers blocked names with 0.0.0.0.
  blockType: zeroIp

# AdGuard cache_size/cache_optimistic.
caching:
  minTime: 5m
  maxTime: 30m
  prefetching: true
  prefetchThreshold: 5

# AdGuard ratelimit: 20 queries/s per client, never for the LAN.
rateLimit:
  enable: true
  rate: 20
  allowlist:
    - 127.0.0.1/32
    - ::1/128
    - 192.168.0.0/16

# AdGuard querylog + statistics, as a local SQLite file.
queryLog:
  type: sqlite
  target: /app/querylog/querylog.db
  logRetentionDays: 7
  fields:
    - clientIP
    - clientName
    - responseReason

# AdGuard hostsfile_enabled.
hostsFile:
  sources:
    - /etc/hosts
  hostsTTL: 1h

# Scraped by Prometheus.
prometheus:
  enable: true
  path: /metrics

log:
  level: info
