# Blocky configuration. Rendered by Ansible; do not edit on the host.

# Quad9 filtered over DoH, and filtered on purpose: its malware list is a second
# layer on top of the HaGeZi blocklists (dns10.quad9.net is the unfiltered pair).
upstreams:
  groups:
    default:
      - https://dns.quad9.net/dns-query

# Plain DNS only to bootstrap the DoH hostname and fetch the blocklists.
bootstrapDns:
  - 9.9.9.9
  - 149.112.112.112
  - 9.9.9.10
  - 149.112.112.10
  - 194.242.2.6
  - 194.242.2.4
  - 1.1.1.1

ports:
  dns: 53
  # 80 keeps the old DoH URL working; 4000 is what the proxy and Prometheus use.
  http:
    - 80
    - 4000

filtering:
  queryTypes:
    - AAAA
    - ANY

# Every *.<zone> name resolves to the proxy.
customDNS:
  customTTL: 1h
  mapping:
    "{{ vault_domainname_hs }}": {{ hostvars['caddy'].ansible_host }}

blocking:
  denylists:
    hagezi:
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/ultimate-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/tif-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/native.apple-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/gambling-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/native.oppo-realme-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/native.winoffice-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/native.xiaomi-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/spam-tlds-onlydomains.txt
      - https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/urlshortener-onlydomains.txt
    special:
      - |
        # AdGuard blocked_hosts
        version.bind
        id.server
        hostname.bind
  allowlists:
    hagezi:
      - |
        # AdGuard user_rules: @@||huggingface.co^$important
        huggingface.co
        cdn-lfs.huggingface.co
        hf.co
  clientGroupsBlock:
    default:
      - hagezi
      - special
  blockType: zeroIp

caching:
  minTime: 5m
  maxTime: 30m
  prefetching: true
  prefetchThreshold: 5

rateLimit:
  enable: true
  rate: 20
  allowlist:
    - 127.0.0.1/32
    - ::1/128
    - 192.168.0.0/16

queryLog:
  type: sqlite
  target: /app/querylog/querylog.db
  logRetentionDays: 7
  fields:
    - clientIP
    - clientName
    - responseReason

hostsFile:
  sources:
    - /etc/hosts
  hostsTTL: 1h

prometheus:
  enable: true
  path: /metrics

log:
  level: info
