{#
   Only what differs from upstream's defaults; `use_default_settings` merges the
   two, and the merged file is checked at boot. No secret: server.secret_key is
   absent on purpose and comes from SEARXNG_SECRET.
#}
use_default_settings:
  engines:
    # Both need a Tor client this image does not ship, and log an error at boot.
    remove:
      - ahmia
      - torch

general:
  # Shown in the UI title and in the JSON "search" block.
  instance_name: "{{ searxng_instance_name }}"

server:
  # Not public: no bot detection, no limiter (it would also need valkey). The
  # only client is the agent; revisit if this is ever published outside the LAN.
  limiter: false
  public_instance: false
  image_proxy: true

search:
  safe_search: 0
  # A third-party request per keystroke, and the agent never types.
  autocomplete: ""
  # JSON is what the agent's web_search tool speaks; upstream ships HTML only.
  formats:
    - html
    - json

outgoing:
  # ZeroClaw gives up after 15s (web_search.timeout_secs).
  request_timeout: 6.0
  max_request_timeout: 12.0
