{#
   Only what differs from upstream's defaults; `use_default_settings` merges the
   two, and the merged file is checked at boot. No secret: server.secret_key is
   absent on purpose and comes from SEARXNG_SECRET.
#}
use_default_settings:
  engines:
    # Both need a Tor client this image does not ship, and log an error at boot.
    remove:
      - ahmia
      - torch
      # General-category engines a human uses and the agent cannot (measured
      # 22-nov, 5 queries): only brave, google cse and duckduckgo returned
      # results. wikidata timed out or 403'd on 5/5 and contributed nothing;
      # wikipedia answered 429 on 179 lookups and 400/500 on 56, with zero
      # results; the rest are dictionaries, a translator and a currency
      # converter. Removing them also removes up to 6 s of wait per query,
      # because every general engine is queried in parallel.
      - wikidata
      - wikipedia
      - dictzone
      - lingva
      - mymemory translated
      - currency

general:
  # Shown in the UI title and in the JSON "search" block.
  instance_name: "{{ searxng_instance_name }}"

server:
  # Not public: no bot detection, no limiter (it would need valkey).
  limiter: false
  public_instance: false
  # The agent reads text; nothing ever fetches an image through here.
  image_proxy: false

search:
  safe_search: 0
  # A third-party request per keystroke, and the agent never types.
  autocomplete: ""
  # JSON is what the agent's web_search tool speaks; upstream ships HTML only.
  formats:
    - html
    - json

outgoing:
  # The agents give up after 15s.
  request_timeout: 6.0
  max_request_timeout: 12.0
