# Rendered from `hermes_agents` (host_vars/llm/main.yml): one profile per file.
{% set a = hermes_agents[item.agent] %}
{#- One model per profile: the normal one for `default`, the uncensored one
    for `uncensored`. `profile_models` comes from models.yml. -#}
{% set profile_model = profile_models[a.model_profile | default('default')] | default(agent_model) %}
model:
  provider: litellm
  default: "{{ profile_model }}"
  base_url: "{{ hermes_llm_uri }}"

providers:
  litellm:
    api: "{{ hermes_llm_uri }}"
    key_env: LITELLM_API_KEY
    default_model: "{{ profile_model }}"
    # One entry per model in models.yml. llama.cpp knows each model's window but
    # Bifrost publishes no /model/info, and without this hermes assumes 128K: it
    # would compress history against a window that does not exist and overflow
    # the ones that are 8K. Nothing to configure per model beyond models.yml.
    models:
{% for m in llm_models %}
      "{{ m.name }}":
        context_length: {{ ((m.args | default({})).get('ctx-size', llm_default_ctx)) | int }}
{% endfor %}

approvals:
  mode: "{{ a.approvals_mode }}"
  # Cron and one-shot runs have nobody to ask.
  cron_mode: "{{ a.unattended_mode }}"
  single_query_mode: "{{ a.unattended_mode }}"
  unattended_mode: "{{ a.unattended_mode }}"
{% if a.deny is defined %}
  deny:   # applies even with mode "off"
{% for pattern in a.deny %}
    - "{{ pattern }}"
{% endfor %}
{% endif %}

auxiliary:
  background_review:   # a full model call after every turn
    enabled: {{ 'true' if a.background_review | default(true) else 'false' }}

compression:
  # Compact at a quarter of the window, or while the card is idle.
  threshold: 0.25
  idle_compact_after_seconds: 300
  tail_mode: lean

# `hermes checkpoints` can undo a turn that broke the working tree.
checkpoints:
  enabled: true

# Facts in SQLite, additive to MEMORY.md; no key and no model call.
memory:
  provider: "{{ a.memory_provider }}"
  write_approval: {{ 'true' if a.memory_write_approval else 'false' }}

web:
  # SearXNG next door; it cannot extract, so extraction stays keyless.
  search_backend: searxng
  extract_backend: ""

timezone: "{{ timezone }}"

plugins:
  enabled:
{% for plugin in a.plugins %}
    - {{ plugin }}
{% endfor %}
  disabled: []

terminal:
  backend: "{{ a.terminal_backend }}"
  cwd: /opt/data/workspace
  timeout: 300
{% if a.telegram | default(false) %}

gateway:
  platforms:
    telegram:
      enabled: true
{% endif %}
