{# Seeded once from hermes_agents; hermes writes state back, hence force: false. #}
{% set a = hermes_agents[item.agent] %}
{% set profile_model = profile_models[a.model_profile | default('default')] | default(agent_model) %}
model:
  provider: {{ hermes_llm_provider }}
  default: "{{ profile_model }}"
  base_url: "{{ hermes_llm_uri }}"

providers:
  {{ hermes_llm_provider }}:
    api: "{{ hermes_llm_uri }}"
    key_env: {{ hermes_llm_key_env }}
    default_model: "{{ profile_model }}"
    # Streaming to a fresh file has no probe: the windows come from models.yml.
    models:
{% for name, cfg in llm_model_contexts.items() %}
      {{ name | to_json }}:
        context_length: {{ cfg.context_length }}
{% endfor %}

approvals:
  mode: "{{ a.approvals_mode }}"
  # Cron and one-shot runs have nobody to ask.
  cron_mode: "{{ a.unattended_mode }}"
  single_query_mode: "{{ a.unattended_mode }}"
  unattended_mode: "{{ a.unattended_mode }}"
{% if a.deny is defined %}
  deny:   # applies even with mode "off"
{% for pattern in a.deny %}
    - "{{ pattern }}"
{% endfor %}
{% endif %}

auxiliary:
  background_review:   # a full model call after every turn
    enabled: {{ 'true' if a.background_review | default(true) else 'false' }}

compression:
  threshold: 0.25
  idle_compact_after_seconds: 300
  tail_mode: lean

checkpoints:
  enabled: true

memory:
  provider: "{{ a.memory_provider }}"
  write_approval: {{ 'true' if a.memory_write_approval else 'false' }}

web:
  # SearXNG next door; it cannot extract, so extraction stays keyless.
  search_backend: searxng
  extract_backend: ""

timezone: "{{ timezone }}"

plugins:
  enabled:
{% for plugin in a.plugins %}
    - {{ plugin }}
{% endfor %}
  disabled: []

terminal:
  backend: "{{ a.terminal_backend }}"
  cwd: {{ hermes_home }}/workspace
  timeout: 300
{% if a.telegram | default(false) %}

gateway:
  platforms:
    telegram:
      enabled: true
{% endif %}
{% if hermes_profile_routes | default([]) and a.telegram | default(false) %}

# Top level on purpose: the loader only bridges the nested form while it is absent.
# One bot per channel; these decide which profile answers where.
profile_routes:
{% for route in hermes_profile_routes %}
  - name: {{ route.name }}
    platform: {{ route.platform }}
    profile: {{ route.profile }}
{% if route.user_id is defined %}
    user_id: "{{ route.user_id }}"
{% endif %}
{% if route.chat_id is defined %}
    chat_id: "{{ route.chat_id }}"
{% endif %}
{% endfor %}
{% endif %}
