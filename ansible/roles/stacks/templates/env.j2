# Managed by Ansible (roles/stacks). Do not edit by hand.
# stack_env_common (group_vars/all) is merged under stack_env_host (host_vars,
# one entry per container) and the stack's own env, which wins on a clash.
{# The published port is the number Caddy proxies to and the catalog links, so
   it comes from service_ports and not from the compose file. #}
{# `gpu-panel` is the stack, `gpu_panel` the catalog key. #}
{% set port_key = stack.name if stack.name in service_ports else (stack.name | replace('-', '_')) %}
{% set ports = {'PUBLISH_PORT': service_ports[port_key]} if port_key in service_ports else {} %}
{% set merged = stack_env_common | default({}) | combine(stack_env_host | default({})) | combine(ports) | combine(stack.env | default({})) %}
{% for key, value in merged | dictsort %}
{{ key }}={{ value }}
{% endfor %}
