# Managed by Ansible (roles/stacks). Do not edit by hand.
# stack_env_common (group_vars/all) is merged under stack_env_host (host_vars,
# one entry per container), then the keys derived below and the stack's own
# env, which wins on a clash.
{# The published port is the number Caddy proxies to and the catalog links, so
   it comes from service_ports and not from the compose file. #}
{# `gpu-panel` is the stack, `gpu_panel` the catalog key. #}
{% set port_key = stack.name if stack.name in service_ports else (stack.name | replace('-', '_')) %}
{% set ports = {'PUBLISH_PORT': service_ports[port_key]} if port_key in service_ports else {} %}
{# Where that port is published. The compose files publish on
   ${PUBLISH_ADDR:-0.0.0.0}, and a stack that only serves through Caddy pins the
   address to the host's own, so no LAN host reaches the port and skips TLS. #}
{% set addr = {'PUBLISH_ADDR': stack.publish_addr} if stack.publish_addr is defined else {} %}
{% set merged = stack_env_common | default({}) | combine(stack_env_host | default({})) | combine(addr) | combine(ports) | combine(stack.env | default({})) %}
{% for key, value in merged | dictsort %}
{{ key }}={{ value }}
{% endfor %}
