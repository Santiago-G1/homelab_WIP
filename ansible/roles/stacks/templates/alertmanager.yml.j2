# Managed by Ansible; do not edit by hand. Prometheus pushes firing rules here
# and this sends them to Telegram. Carries the bot token, hence mode 0600.
global:
  resolve_timeout: 5m

route:
  receiver: telegram
  # One alertname per host is one conversation.
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  # A warning still firing after four hours is worth repeating.
  repeat_interval: 4h
  routes:
    - matchers: ['severity="critical"']
      receiver: telegram
      group_wait: 10s
      repeat_interval: 1h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: '{{ vault_alertmanager_telegram_bot_token }}'
        chat_id: {{ vault_zeroclaw_telegram_user_id }}
        api_url: https://api.telegram.org
        parse_mode: HTML
        send_resolved: true
        # The Go template is left alone by Jinja on purpose: Alertmanager is the
        # one that fills it in.
        message: |-
          {% raw %}{{ if eq .Status "firing" }}<b>FIRING</b>{{ else }}<b>RESUELTO</b>{{ end }} · {{ .Alerts | len }} alerta(s)
          {{ range .Alerts }}
          <b>{{ .Labels.alertname }}</b> ({{ .Labels.severity }})
          host: {{ if .Labels.host }}{{ .Labels.host }}{{ else }}{{ .Labels.instance }}{{ end }}
          {{ .Annotations.summary }}
          {{ .Annotations.description }}
          {{ end }}{% endraw %}
