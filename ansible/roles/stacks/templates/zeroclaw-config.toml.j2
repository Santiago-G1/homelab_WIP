# Rendered by Ansible. Secrets arrive as ZEROCLAW_* env overrides, never here;
# the daemon adds pairing tokens to this file, so expect drift.
schema_version = 3

{# One profile, fixed key: the router keeps one GGUF resident, and the compose
   env that carries the api key cannot follow a variable. #}
{% set m = (llm_models | selectattr('agent', 'defined') | first) %}
[providers.models.litellm.agent]
uri = "{{ zeroclaw_litellm_uri }}"
model = "{{ m.name }}"
context_window = {{ (m.args | default({}))['ctx-size'] | default(zeroclaw_context_window) }}
max_tokens = {{ zeroclaw_max_tokens }}
timeout_secs = {{ zeroclaw_provider_timeout_secs }}
{% if m.args is defined and m.args['temp'] is defined %}
temperature = {{ m.args['temp'] }}
{% endif %}

[agents.default]
enabled = true
model_provider = "litellm.agent"
risk_profile = "sandboxed"
runtime_profile = "agent"
# An enabled channel no agent lists is not started.
channels = ["telegram.home"]

[agents.default.workspace]
# Must match the compose bind mount: the sandbox mounts it by host path.
path = "{{ stacks_root }}/zeroclaw/workspace"

# Local agents and risk profiles live in a gitignored file, so a clone renders
# without them.
{% include 'zeroclaw-local.toml' ignore missing %}

[risk_profiles.sandboxed]
# `supervised` asks before risky tools.
level = "supervised"
workspace_only = true
sandbox_enabled = true
sandbox_backend = "docker"
sandbox_image = "{{ zeroclaw_sandbox_image }}"

[runtime_profiles.agent]
agentic = true
# Nothing here is billed per call, so what needs bounding is time and looping:
# the stock 12 iterations, 20 actions/hour and 2 KB per tool result cut a normal
# read -> edit -> test turn short.
max_tool_iterations = {{ zeroclaw_max_tool_iterations }}
max_actions_per_hour = {{ zeroclaw_max_actions_per_hour }}
max_tool_result_chars = {{ zeroclaw_max_tool_result_chars }}
# The agent's budget, not the server's: leaves room for the reply.
max_context_tokens = {{ zeroclaw_max_context_tokens }}

[web_search]
# DuckDuckGo starts returning empty results after a few queries, so search goes
# through the SearXNG instance on the shared network.
search_provider = "searxng"
searxng_instance_url = "{{ zeroclaw_searxng_instance_url }}"
max_results = 5
# SearXNG caps a search at 12s.
timeout_secs = 15

[channels]
# The local models load on demand, so a message can wait minutes before the
# first token: the stock 300 s budget cuts it off.
message_timeout_secs = {{ zeroclaw_message_timeout_secs }}

[channels.telegram.home]
enabled = true

# Empty peers deny everyone; the owner is pre-authorized by numeric ID.
[peer_groups.telegram_home]
channel = "telegram.home"
external_peers = ["{{ zeroclaw_telegram_user_id }}"]

[gateway]
port = {{ service_ports.zeroclaw }}
host = "0.0.0.0"
allow_public_bind = true
require_pairing = true
web_dist_dir = "/usr/share/zeroclawlabs/web/dist"
