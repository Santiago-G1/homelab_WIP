# Rendered by Ansible (roles/stacks) into /zeroclaw-data/.zeroclaw/config.toml.
# Secrets arrive as ZEROCLAW_* env overrides, never here. The daemon adds
# pairing tokens to this file, so expect drift there. See README.md.
schema_version = 3

[providers.models.litellm.local]
uri = "{{ zeroclaw_litellm_uri }}"
model = "{{ zeroclaw_model }}"
# llama.cpp serves a 64K window; the runtime keeps a smaller input budget.
context_window = 65536
max_tokens = 8192

[agents.default]
enabled = true
model_provider = "litellm.local"
risk_profile = "sandboxed"
runtime_profile = "agent"
# An enabled channel no agent lists is not started, so be explicit.
channels = ["telegram.home"]

[agents.default.workspace]
# Must match the compose bind mount: the sandbox mounts it by host path.
path = "/opt/docker/zeroclaw/workspace"

[risk_profiles.sandboxed]
# `supervised` asks before risky tools; the sandbox confines what runs.
level = "supervised"
workspace_only = true
sandbox_enabled = true
sandbox_backend = "docker"
sandbox_image = "zeroclaw-sandbox:1"

[runtime_profiles.agent]
agentic = true
max_tool_iterations = 12
# The agent's window, not the server's: leave room for the reply inside
# llamacpp ctx-size (see zeroclaw_max_context_tokens in host_vars).
max_context_tokens = {{ zeroclaw_max_context_tokens | default(24000) }}

[web_search]
# DuckDuckGo's HTML endpoint starts answering empty results for this daemon
# after a handful of queries from the same IP, so search goes through the
# SearXNG instance on the shared network. See the searxng stack's README.
search_provider = "searxng"
searxng_instance_url = "{{ zeroclaw_searxng_instance_url }}"
max_results = 5
# SearXNG caps a search at 12s (outgoing.max_request_timeout); do not wait
# longer than the answer is worth.
timeout_secs = 15

[channels.telegram.home]
enabled = true

# Empty peers deny everyone; the owner is pre-authorized by numeric ID.
[peer_groups.telegram_home]
channel = "telegram.home"
external_peers = ["{{ zeroclaw_telegram_user_id }}"]

[gateway]
port = 42617
host = "0.0.0.0"
allow_public_bind = true
require_pairing = true
web_dist_dir = "/usr/share/zeroclawlabs/web/dist"
