vault_cloud_mount: /path/to/data
vault_cloudflare_api_token: CHANGE-ME
vault_cloudflare_tunnel_token: CHANGE-ME
vault_domainname_hs: domain.com
vault_filebrowser_admin_password: CHANGE-ME
vault_gf_database_name: grafana_prod_db
vault_gf_database_password: change-me
vault_gf_database_user: grafana_prod_user

# Glance dashboard on the monitoring container. The session key must be base64
# that decodes to exactly 64 bytes (Glance rejects anything else), so generate
# it instead of typing one:
#   docker run --rm glanceapp/glance secret:make
#   openssl rand -base64 64 | tr -d '\n'      # 88 characters
vault_glance_secret_key: CHANGE-ME
vault_glance_admin_password: CHANGE-ME
vault_immich_db_data_location: /opt/immich/database
vault_immich_db_database_name: immich_prod_db
vault_immich_db_password: postgres
vault_immich_db_username: postgres
vault_immich_upload_location: /path/to/immich
vault_immich_version: v3
vault_litellm_db_password: change-me
vault_litellm_master_key: sk-change-me
vault_litellm_salt_key: change-me
vault_llm_mount: /path/to/data
vault_onlyoffice_jwt_secret: CHANGE-ME
vault_samba_password: CHANGE-ME
vault_samba_user: user
vault_slskd_api_key: CHANGE-ME
vault_slskd_password: SOULSEEK-PASSWORD
vault_slskd_username: SOULSEEK-NAME
vault_sync_mount: /path/to/data
vault_tailscale_auth_key: CHANGE-ME

# ZeroClaw -> LiteLLM virtual key (sk-...); rendered as ZEROCLAW_LITELLM_API_KEY
vault_zeroclaw_litellm_api_key: sk-replace-me

# ZeroClaw Telegram bot token from @BotFather (<id>:<secret>); rendered as ZEROCLAW_TELEGRAM_BOT_TOKEN
vault_zeroclaw_telegram_bot_token: 123456789:replace-me

# Telegram account allowed to talk to the agent (external_peers in the
# ZeroClaw config). Numeric ID only: it survives a display-name change.
vault_zeroclaw_telegram_user_id: 123456789
