      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "fstype": true,
              "device": true,
              "instance": true
            },
            "renameByName": {
              "host": "host",
              "mountpoint": "montaje",
              "Value": "% usado"
            },
            "indexByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
