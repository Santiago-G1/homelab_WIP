    {
      "type": "stat",
      "title": "Servicios ca\u00eddos",
      "description": "Targets de Prometheus que no responden. Si es > 0, mira la tabla de abajo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(up == 0) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
