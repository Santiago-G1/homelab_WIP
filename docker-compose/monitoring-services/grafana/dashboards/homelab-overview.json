    {
      "type": "table",
      "title": "Servicios ca\u00eddos",
      "description": "Que target esta caido y en que host. Vacio = todo arriba.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
