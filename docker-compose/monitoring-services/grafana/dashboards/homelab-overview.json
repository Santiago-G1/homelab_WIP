    {
      "type": "stat",
      "title": "Discos casi llenos",
      "description": "Filesystems por encima del 85% de uso. Es lo que tumbo Immich por espacio.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count((100 * (1 - (node_filesystem_avail_bytes{fstype=~\"ext4|zfs\",mountpoint=~\"/|/mnt/.+\"} / node_filesystem_size_bytes{fstype=~\"ext4|zfs\",mountpoint=~\"/|/mnt/.+\"}))) > 85) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
