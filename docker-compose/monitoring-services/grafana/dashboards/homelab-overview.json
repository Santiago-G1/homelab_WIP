    {
      "type": "timeseries",
      "title": "DNS (blocky)",
      "description": "Consultas por segundo y cuantas de ellas se bloquean. Un desplome a cero significa que la red no esta resolviendo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(blocky_query_total[5m]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "consultas/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(blocky_response_total{response_type=\"BLOCKED\"}[5m]))",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "bloqueadas/s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
