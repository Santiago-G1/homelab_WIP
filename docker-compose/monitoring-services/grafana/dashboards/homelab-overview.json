    {
      "type": "table",
      "title": "Discos",
      "description": "Uso de cada filesystem con datos (raiz del contenedor y datasets del pool). Ordenado de mas lleno a menos: la primera fila es la que hay que mirar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 14,
        "x": 10,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - (node_filesystem_avail_bytes{fstype=~\"ext4|zfs\",mountpoint=~\"/|/mnt/.+\"} / node_filesystem_size_bytes{fstype=~\"ext4|zfs\",mountpoint=~\"/|/mnt/.+\"}))",
          "refId": "A",
          "range": false,
          "instant": true
        }
