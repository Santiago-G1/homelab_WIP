# The route table lives in the (routes) snippet below: one line per hostname

{
	email admin@{$DOMAINNAME_HS}
	# Site addresses are declared explicitly, so no redirect server is created.
	auto_https disable_redirects
}

# Certificates come from Let's Encrypt through the Cloudflare DNS-01
# challenge, which also lets Caddy issue the *.{$DOMAINNAME_HS} wildcard in
# one go (the API token is injected as an environment variable).
(routes) {
	map {host} {backend} {
		# Blocky has no web UI; this serves its API, DoH (/dns-query) and metrics.
		blocky.{$DOMAINNAME_HS}    192.168.10.3:4000
		bazarr.{$DOMAINNAME_HS}    192.168.10.20:6767
		calibre.{$DOMAINNAME_HS}   192.168.10.20:8082
		seerr.{$DOMAINNAME_HS}     192.168.10.20:5055
		slskd.{$DOMAINNAME_HS}     192.168.10.20:5030
	        prowlarr.{$DOMAINNAME_HS}  192.168.10.20:9696
		radarr.{$DOMAINNAME_HS}    192.168.10.20:7878
		sonarr.{$DOMAINNAME_HS}    192.168.10.20:8989
		cloud.{$DOMAINNAME_HS}     192.168.10.25:80
		torrent.{$DOMAINNAME_HS}   192.168.10.20:8080
		movies.{$DOMAINNAME_HS}    192.168.10.21:8096
		komga.{$DOMAINNAME_HS}     192.168.10.21:25600
		music.{$DOMAINNAME_HS}     192.168.10.21:4533
		immich.{$DOMAINNAME_HS}    192.168.10.22:2283
		password.{$DOMAINNAME_HS}  192.168.10.23:8000
		sync.{$DOMAINNAME_HS}      192.168.10.25:8384
		grafana.{$DOMAINNAME_HS}   192.168.10.10:3000
                calendar.{$DOMAINNAME_HS}  192.168.10.24:5232
		
		#work in progress
		#litellm.{$DOMAINNAME_HS} 192.168.10.26:4000
		#comfyui.{$DOMAINNAME_HS} 192.168.10.26:8188
		#openwebui.{$DOMAINNAME_HS} 192.168.10.26:3000
	}
	reverse_proxy {backend}
}

https://*.{$DOMAINNAME_HS} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# The zone lookup must not use the lab resolver: Blocky answers every
		# *.{$DOMAINNAME_HS} name itself, so the plugin cannot see the NS records.
	}
	import routes
}

http://*.{$DOMAINNAME_HS} {
	redir https://{host}{uri} permanent
}


