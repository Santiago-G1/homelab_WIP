# Reverse proxy for the homelab services (replaces Nginx Proxy Manager).
#
# The route table lives in the (routes) snippet below: one line per hostname
# from the DNS plan, pointing at the container that runs the service. Both the
# HTTPS site and the plain HTTP site
# import it, so the Cloudflare tunnel can use either origin.
{
	email admin@domain.com
	# Site addresses are declared explicitly, so no redirect server is created.
	auto_https disable_redirects
}

# Certificates come from Let's Encrypt through the Cloudflare DNS-01
# challenge, which also lets Caddy issue the *.domain.com wildcard in
# one go (the API token is injected as an environment variable).
(routes) {
	map {host} {backend} {
		# Blocky has no web UI; this serves its API, DoH (/dns-query) and metrics.
		adguard.domain.com 192.168.10.3:4000
		bazarr.domain.com 192.168.10.20:6767
		calibre.domain.com 192.168.10.20:8082
		downloadmovies.domain.com 192.168.10.20:5055
		downloadmusic.domain.com 192.168.10.20:5030
		prowlarr.domain.com 192.168.10.20:9696
		radarr.domain.com 192.168.10.20:7878
		sonarr.domain.com 192.168.10.20:8989
		soulsync.domain.com 192.168.10.20:8008
		torrent.domain.com 192.168.10.20:8080
		movies.domain.com 192.168.10.21:8096
		komga.domain.com 192.168.10.21:25600
		music.domain.com 192.168.10.21:4533
		immich.domain.com 192.168.10.22:2283
		password.domain.com 192.168.10.23:8000
		sync.domain.com 192.168.10.25:8384
		grafana.domain.com 192.168.10.10:3000
	}

	reverse_proxy {backend}
}

https://*.domain.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# The zone lookup must not use the lab resolver: Blocky answers every
		# *.domain.com name itself, so the plugin cannot see the NS records.
	}
	import routes
}

http://*.domain.com {
	import routes
}

# Served by another host or not deployed yet: redlib, asic (HiveOn Hub).
# Kept internal on purpose: prometheus -> 192.168.10.10:9090,
# files -> 192.168.10.25:80 (Filebrowser), calendar -> 192.168.10.24:5232.
