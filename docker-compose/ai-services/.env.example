# ComfyUI

# Container internal workspace path
WORKSPACE=/workspace

# Host paths (must contain unet/, clip/, vae/ subfolders in IMAGE_MODELS_PATH)
IMAGE_MODELS_PATH=/path/to/image_models
OUTPUT_PATH=/path/to/comfyui_output

# ComfyUI startup args
COMFYUI_ARGS=--force-fp32 --fp32-vae --normalvram

# Direct access IP/domain (leave empty if unused)
DIRECT_ADDRESS=

# Cloudflare Tunnel token (optional)
CF_TUNNEL_TOKEN=

# Model download tokens (optional)
CIVITAI_TOKEN=
HF_TOKEN=

# Web UI auth (true/false)
WEB_ENABLE_AUTH=false

# llama-swap

# Host path for models/data
MODELS_DATA_PATH=/path/to/models

# LiteLLM
# Postgres credentials for LiteLLM
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
# Required: use a strong password
LITELLM_DB_PASSWORD=change_me

# Proxy master key (required in production)
# Generate: openssl rand -hex 32
LITELLM_MASTER_KEY=

# Salt key for encrypting DB credentials
# Generate: openssl rand -hex 32
LITELLM_SALT_KEY=
