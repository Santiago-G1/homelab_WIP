# Rendered to .env (mode 0600) by Ansible from the encrypted vault; .env is
# gitignored, this template is not. Keep both keys out of every tracked file.
#
# LiteLLM virtual key the `litellm.local` provider alias authenticates with.
# docker-compose.yml forwards it as
# ZEROCLAW_providers__models__litellm__local__api_key.
ZEROCLAW_LITELLM_API_KEY=sk-replace-me

# Telegram bot token from @BotFather. docker-compose.yml forwards it as
# ZEROCLAW_channels__telegram__home__bot_token; the channel and its inbound
# authorization live in the rendered config.
ZEROCLAW_TELEGRAM_BOT_TOKEN=123456789:replace-me
