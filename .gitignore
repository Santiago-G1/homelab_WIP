# Credentials and secrets
*.tfvars
*.tfvars.json
.env
.env.*
**/.env
*.env
*.pem
*.key
*secret*
*password*

# Versioned templates (never real secrets)
!.env.example
!.env.template
!.env.sample

# FILEBROWSER (runtime data, never commit)
**/filebrowser/config/database.sqlite
**/filebrowser/config/*.sqlite
**/filebrowser/config/*.db

# SAMBA (credentials, use users.conf.template)
**/samba/users.conf

# Stack runtime dirs (compose bind sources, may hold credentials)
docker-compose/**/data/

# TERRAFORM
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ANSIBLE
*.vault
.vault_pass

# System
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp
*.bak

# PYTHON
__pycache__/
*.pyc

# EPUB FETCHER (URL list and personal overrides: never commit)
**/epub-fetcher/data/urls.txt
**/epub-fetcher/data/personal.ini
**/epub-fetcher/data/.last-run
